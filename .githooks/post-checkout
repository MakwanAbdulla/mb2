#!/bin/bash
# Runs after `git checkout <branch>`. Args per githooks(5):
#   $1 = previous HEAD, $2 = new HEAD, $3 = 1 if a branch checkout (0 if just files)
prev_head="$1"
new_head="$2"
is_branch_checkout="$3"

if [ "$is_branch_checkout" = "1" ] && [ "$prev_head" != "$new_head" ]; then
    "$(git rev-parse --show-toplevel)/.githooks/check-deps.sh" "$prev_head" "$new_head"
fi
