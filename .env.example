# ── Application ───────────────────────────────────────────────────────────────
APP_NAME="Armagedon"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Europe/Stockholm
APP_LOCALE=sv
APP_FALLBACK_LOCALE=sv
APP_FAKER_LOCALE=sv_SE
APP_MAINTENANCE_DRIVER=file

# ── Logging ───────────────────────────────────────────────────────────────────
# daily = rotates to a new file each night, keeps LOG_DAILY_DAYS of history
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Database ──────────────────────────────────────────────────────────────────
# Production and local dev both use MySQL. SQLite works too — see docs/guides/dev-setup.md.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=membrum2
DB_USERNAME=membrum2
DB_PASSWORD=secret

# ── Queue / Cache / Session ───────────────────────────────────────────────────
# sync = all jobs run inline, no worker needed (shared hosting constraint)
QUEUE_CONNECTION=sync
CACHE_STORE=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
BCRYPT_ROUNDS=12

# ── Mail ──────────────────────────────────────────────────────────────────────
# "log" writes emails to storage/logs/laravel.log — no mail server needed for dev.
# Use Mailpit (https://github.com/axllent/mailpit) to view emails in a browser:
#   docker run -d -p 8025:8025 -p 1025:1025 axllent/mailpit
#   Then set MAIL_MAILER=smtp MAIL_HOST=localhost MAIL_PORT=1025
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_SCHEME=null
MAIL_FROM_ADDRESS="noreply@example.se"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_REPLY_TO_ADDRESS=
MAIL_REPLY_TO_NAME="${APP_NAME}"
MAIL_CONTACT_ADDRESS=
MAIL_ADMIN_EMAIL=
MAIL_EHLO_DOMAIN=

# ── Google OAuth (SSO login) — optional ───────────────────────────────────────
# Create credentials at https://console.cloud.google.com/ → APIs & Services → Credentials
# Authorized redirect URI: ${APP_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Google Workspace (admin provisioning) — optional ──────────────────────────
# Only needed if the association uses Google Workspace for member email accounts.
# Requires a service account with Domain-Wide Delegation enabled.
GOOGLE_WORKSPACE_ENABLED=false
GOOGLE_WORKSPACE_DOMAIN=
GOOGLE_WORKSPACE_ADMIN_EMAIL=
GOOGLE_WORKSPACE_CREDENTIALS=   # file path or raw JSON of service account key

# ── Discord — optional ────────────────────────────────────────────────────────
# Create an application at https://discord.com/developers/applications
# Authorized redirect URIs:
#   ${APP_URL}/auth/discord/callback
#   ${APP_URL}/discord/linked-role/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=     # only needed for server role sync
DISCORD_GUILD_ID=      # numeric ID of the Discord server
DISCORD_PUBLIC_KEY=    # used for verifying incoming requests from Discord

# ── Passkeys (WebAuthn) — optional ────────────────────────────────────────────
# Set this if you ever need to rotate APP_KEY without invalidating existing passkeys.
# Defaults to APP_KEY value if not set.
# PASSKEYS_USER_HANDLE_SECRET=

# ── CogWorks (member activity reporting) — optional ───────────────────────────
# Legacy integration. Login falls back to local password auth when not configured.
COGWORKS_API_TOKEN=
COGWORKS_ORG_CODE=

# ── Stripe — optional ─────────────────────────────────────────────────────────
# Not configured here — set publishable/secret/webhook keys under
# /admin/installningar (payment.stripe_* in system_settings). Use the Stripe
# CLI to forward webhooks locally: stripe listen --forward-to localhost:8000/stripe/webhook
#
# Seed-only dev convenience: uncomment and fill these in your own (gitignored)
# .env to have `php artisan db:seed` copy them into system_settings so a
# `migrate:fresh --seed` doesn't lose your Stripe test keys. Never read by
# the live app — only MembershipPaymentSeeder, and only in local env.
# STRIPE_KEY=
# STRIPE_SECRET=
# STRIPE_WEBHOOK_SECRET=

# ── Swish — optional ──────────────────────────────────────────────────────────
# Not configured here — upload the merchant .p12 certificate and set the
# passphrase under /admin/installningar (payment.swish_* in system_settings).
# Swish's public MSS sandbox test certificate works too (payee alias
# 1234679304 auto-routes Payment Request calls to the sandbox API).

# ── Zettle (PayPal POS) — optional ────────────────────────────────────────────
ZETTLE_CLIENT_ID=
ZETTLE_ASSERTION=

# ── SumUp — optional ──────────────────────────────────────────────────────────
SUMUP_API_KEY=
SUMUP_PUBLIC_KEY=

# ── Inleed DocSign (BankID e-signing) — optional ──────────────────────────────
# Without a key, e-signing is disabled. Environments may share one DocSign account.
DOCSIGN_API_KEY=
# Free demo documents without real signing. Defaults to true unless APP_ENV=production —
# set DOCSIGN_DEMO=true on any test environment that runs as production.
DOCSIGN_DEMO=
# Prefix for our signer ids at DocSign (external_id). Defaults to APP_URL's host,
# which keeps environments sharing one account apart.
DOCSIGN_EXTERNAL_ID_PREFIX=
# Addresses DocSign callbacks may come from (comma-separated, CIDR allowed). Leave
# commented out for Inleed's two; set it empty only to accept any address.
# DOCSIGN_CALLBACK_IPS=194.68.59.169,194.68.59.115
# Anonymize external signers this many years after their last request closed.
# Leave empty until the association has decided — pruning is then disabled.
DOCSIGN_EXTERNAL_RETENTION_YEARS=

# ── Anthropic (AI receipt/PDF scanning) — optional ────────────────────────────
# Used by the accounting module to extract data from uploaded receipts and invoices.
# Without this key, manual entry is required instead. Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_PDF_MODEL=claude-haiku-4-5-20251001

# ── Accounting inbox (IMAP) — optional ────────────────────────────────────────
# Forward supplier invoices to a dedicated mailbox; the system imports them automatically.
ACCOUNTING_INBOX_HOST=
ACCOUNTING_INBOX_PORT=993
ACCOUNTING_INBOX_ENCRYPTION=ssl
ACCOUNTING_INBOX_USERNAME=
ACCOUNTING_INBOX_PASSWORD=
ACCOUNTING_INBOX_FOLDER=INBOX
ACCOUNTING_INBOX_DELETE_AFTER_IMPORT=false

# ── Kiosk ─────────────────────────────────────────────────────────────────────
KIOSK_TIMEOUT_MINUTES=5

# ── Vite ──────────────────────────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"
